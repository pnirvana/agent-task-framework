{
  "name": "agent-task-framework",
  "version": "0.1.0",
  "description": "Harness-independent protocol + CLI for coordinator/subagent plans, tasks and progress tracking",
  "type": "module",
  "bin": {
    "atf": "bin/atf.mjs",
    "atf-herdr": "adapters/herdr/atf-herdr.mjs",
    "atf-copilot": "adapters/copilot/atf-copilot.mjs"
  },
  "exports": {
    ".": "./src/core.mjs",
    "./store": "./src/store.mjs",
    "./schema": "./schema/event.schema.json"
  },
  "scripts": {
    "test": "node --test test/atf.test.mjs"
  },
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["./adapters/pi/atf.ts", "./adapters/pi/atf-live.ts"]
  },
  "engines": { "node": ">=18" },
  "license": "MIT"
}
